+/* A previously-restored slot must still equal its recorded original. */
+#define RESOLVE_QSEE_SLOT(State, Slot, Original, Wrapper) do { \
+  if ((State) == HOOK_SLOT_OWNED) { \
+    if ((Slot) == (Wrapper)) { (Slot) = (Original); (State) = HOOK_SLOT_RESTORED; } \
+    else if ((Slot) == (Original)) { (State) = HOOK_SLOT_RESTORED; } \
+    else { (State) = HOOK_SLOT_FOREIGN; } \
+  } else if ((State) == HOOK_SLOT_FOREIGN) { \
+    if ((Slot) == (Wrapper)) { (State) = HOOK_SLOT_OWNED; } \
+    else if ((Slot) == (Original)) { (State) = HOOK_SLOT_RESTORED; } \
+  } else if ((State) == HOOK_SLOT_RESTORED) { \
+    if ((Slot) != (Original)) { (State) = HOOK_SLOT_FOREIGN; } \
+  } else if ((State) == HOOK_SLOT_ABSENT || (State) == HOOK_SLOT_STOCK) { \
+    if ((Slot) != (Original)) { (State) = HOOK_SLOT_FOREIGN; } \
+  } else { \
+    (State) = HOOK_SLOT_FOREIGN; \
+  } \
