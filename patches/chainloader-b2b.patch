diff --git a/GblChainloadPkg/Application/GblChainload/CachedPeGate.h b/GblChainloadPkg/Application/GblChainload/CachedPeGate.h
new file mode 100644
index 0000000000000000000000000000000000000000..5240df370a532e4e1a38a300b952a6fbe2077b08
--- /dev/null
+++ b/GblChainloadPkg/Application/GblChainload/CachedPeGate.h
@@ -0,0 +1,29 @@
+/** Minimal cached ABL PE sanity gate, shared with the host test. */
+#ifndef GBL_CACHED_PE_GATE_H
+#define GBL_CACHED_PE_GATE_H
+
+#include <stdint.h>
+
+static int
+GblCachedPeIsSane (const uint8_t *Pe, uint32_t PeSize)
+{
+  uint32_t PeOffset;
+
+  if (Pe == 0 || PeSize < 0x100 || Pe[0] != 'M' || Pe[1] != 'Z') {
+    return 0;
+  }
+
+  PeOffset = (uint32_t) Pe[0x3c] | ((uint32_t) Pe[0x3d] << 8) |
+             ((uint32_t) Pe[0x3e] << 16) | ((uint32_t) Pe[0x3f] << 24);
+
+  /* PeSize >= 0x100 above, so the subtraction cannot underflow. */
+  if (PeOffset > PeSize - 0x40) {
+    return 0;
+  }
+
+  return Pe[PeOffset] == 'P' && Pe[PeOffset + 1] == 'E' &&
+         Pe[PeOffset + 2] == 0 && Pe[PeOffset + 3] == 0 &&
+         Pe[PeOffset + 4] == 0x64 && Pe[PeOffset + 5] == 0xaa;
+}
+
+#endif
