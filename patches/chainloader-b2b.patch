+STATIC BOOLEAN
+RollbackResultIsClean (HOOK_UNINSTALL_RESULT Result)
+{
+  return Result == HOOK_UNINSTALLED || Result == HOOK_NOT_INSTALLED;
+}
+
+/* Attempt all five regardless of individual failures.  Records survive a
+   successful pass so subsequent calls revalidate the live protocol slots. */
+HOOK_UNINSTALL_RESULT
+EFIAPI
+ProtocolHook_UninstallAll (VOID)
+{
+  HOOK_UNINSTALL_RESULT Block, Spss, Qsee, Scm, Vb;
+
+  Block = UninstallBlockIoHook ();
+  Spss  = UninstallSpssHook ();
+  Qsee  = UninstallQseecomHook ();
+  Scm   = UninstallScmHook ();
+  Vb    = UninstallVerifiedBootHook ();
+
+  if ((Block != HOOK_UNINSTALLED && Block != HOOK_NOT_INSTALLED) ||
+      (Spss != HOOK_UNINSTALLED && Spss != HOOK_NOT_INSTALLED) ||
+      (Qsee != HOOK_UNINSTALLED && Qsee != HOOK_NOT_INSTALLED) ||
+      (Scm != HOOK_UNINSTALLED && Scm != HOOK_NOT_INSTALLED) ||
+      (Vb != HOOK_UNINSTALLED && Vb != HOOK_NOT_INSTALLED))
+    return HOOK_UNRESOLVED;
+  if (Block == HOOK_UNINSTALLED || Spss == HOOK_UNINSTALLED ||
+      Qsee == HOOK_UNINSTALLED || Scm == HOOK_UNINSTALLED ||
+      Vb == HOOK_UNINSTALLED) return HOOK_UNINSTALLED;
+  return HOOK_NOT_INSTALLED;
+}
+
+BOOLEAN
+EFIAPI
+ProtocolHook_HooksResolved (VOID)
+{
+  /* This deliberately rechecks current state rather than a cached result. */
+  return RollbackResultIsClean (ProtocolHook_UninstallAll ());
+}
