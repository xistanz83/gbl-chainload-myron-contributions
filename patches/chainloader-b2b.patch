diff --git a/tests/host/hook_rollback/include/Uefi.h b/tests/host/hook_rollback/include/Uefi.h
new file mode 100644
index 0000000000000000000000000000000000000000..64bc63755f461a8f8321cef4688e6ccf8f102aa7
--- /dev/null
+++ b/tests/host/hook_rollback/include/Uefi.h
@@ -0,0 +1,83 @@
+/* Mock UEFI core types for host-side white-box testing of production
+ * GblChainloadPkg hook sources. Self-contained: no edk2 tree required.
+ *
+ * Status-code values are self-consistent within this harness; only the
+ * identity of each code matters to the tests, not its numeric value.
+ */
+#ifndef MOCK_UEFI_H
+#define MOCK_UEFI_H
+
+#include <stdint.h>
+#include <wchar.h>
+
+typedef uint8_t    UINT8;
+typedef uint16_t   UINT16;
+typedef uint32_t   UINT32;
+typedef uint64_t   UINT64;
+typedef uintptr_t  UINTN;
+typedef int8_t     INT8;
+typedef int16_t    INT16;
+typedef int32_t    INT32;
+typedef int64_t    INT64;
+typedef intptr_t   INTN;
+
+typedef void       VOID;
+typedef UINT8      BOOLEAN;
+typedef char       CHAR8;
+/* wchar_t so that the production source's L"" literals typecheck
+ * natively on this host (32-bit wchar_t). Character-wise logic is
+ * identical; only field sizes scale. */
+typedef wchar_t    CHAR16;
+
+typedef UINTN      EFI_STATUS;
+typedef UINTN      EFI_TPL;
+typedef UINT64     EFI_LBA;
+typedef UINTN      EFI_HANDLE;
+
+typedef struct {
+  UINT32 TimeLow;
+  UINT16 TimeHigh;
+  UINT16 TimeHigh2;
+  UINT8  Node[8];
+} EFI_GUID;
+
+#define TRUE  1
+#define FALSE 0
+
+#define IN
+#define OUT
+#define CONST const
+#define STATIC static
+#define EFIAPI
+
+#ifndef NULL
+#define NULL ((void *)0)
+#endif
+
+#define EFI_ERROR(A) (((INTN)(A)) < 0)
+
+#define TPL_APPLICATION  4
+#define TPL_CALLBACK     3
+#define TPL_NOTIFY       2
+#define TPL_HIGH_LEVEL   1
+
+/* Success codes */
+#define EFI_SUCCESS            0
+#define EFI_LOAD_ERROR         1
+#define EFI_INVALID_PARAMETER  2
+#define EFI_UNSUPPORTED        3
+#define EFI_BAD_BUFFER_SIZE    4
+#define EFI_BUFFER_TOO_SMALL   5
+
+/* Error codes (MSB set) */
+#define EFI_NOT_FOUND          0x80000002ULL
+#define EFI_TIMEOUT            0x80000008ULL
+#define EFI_OUT_OF_RESOURCES   0x80000009ULL
+#define EFI_NOT_READY          0x8000000DULL
+#define EFI_DEVICE_ERROR       0x8000001EULL
+#define EFI_WRITE_PROTECTED    0x8000001FULL
+#define EFI_ALREADY_STARTED    0x80000018ULL
+#define EFI_SECURITY_VIOLATION 0x80000034ULL
+#define EFI_NO_MEDIA           0x80000080ULL
+
+#endif /* MOCK_UEFI_H */
