new file mode 100644
index 0000000000000000000000000000000000000000..647acc99d4fc6eed047b892d5fc79763c231611a
--- /dev/null
+++ b/crates/patch-engine/tests/firmware_identity.rs
@@ -0,0 +1,216 @@
+//! Host regression coverage for the Tier 2 firmware-identity gate (R3).
+//!
+//! The gate computes SHA-256 over the complete original, unmodified ABL PE
+//! and accepts it only if it matches the compiled trusted myron Global .302
+//! selected-PE identity. These tests pin the fail-closed behaviour at both the
+//! Rust API and the C-ABI (FFI) boundary, and cross-validate the hand-written
+//! no_std SHA-256 against the independent `gblp1::sha256` implementation.
+
+use std::fs;
+use std::path::PathBuf;
+
+use patch_engine::abl_permissive::verify::{
+    sha256, verify_source_identity, VerifyStatus,
+};
+use patch_engine::ffi::DynamicPatch_VerifySourceIdentity;
+
+fn repo_root() -> PathBuf {
+    let mut path = PathBuf::from(env!("CARGO_MANIFEST_DIR"));
+    path.pop();
+    path.pop();
+    path
+}
+
+// The trusted fixture is device-specific recovery material that the repo
+// policy marks LOCAL ONLY (see .gitignore); it is never committed. Tests
+// that need it skip cleanly when it is absent (e.g. on CI) and run in full
+// on a machine that has it.
+fn read_fixture(name: &str) -> Option<Vec<u8>> {
+    let path = repo_root().join("tests/images/pe").join(name);
+    match fs::read(&path) {
+        Ok(bytes) => Some(bytes),
+        Err(_) => None,
+    }
+}
+
+/// The trusted myron Global .302 selected-PE fixture. Its SHA-256 is the
+/// compiled `TRUSTED_MYRON_GLOBAL_302_PE_SHA256` constant.
+fn trusted_pe() -> Option<Vec<u8>> {
+    read_fixture("myron-global-302.efi")
+}
+
+/// A different, unsupported firmware PE (Infiniti EU) — a valid PE image but
+/// not the trusted myron Global .302 identity.
+fn other_firmware_pe() -> Option<Vec<u8>> {
+    read_fixture("infiniti-EU-16.0.5.703.efi")
+}
+
+#[test]
+fn sha256_matches_independent_gblp1_implementation() {
+    // Cross-validate the hand-written no_std SHA-256 against gblp1::sha256 on
+    // the trusted fixture and a range of edge-case lengths (empty, sub-block,
+    // exact block boundary, multi-block).
+    let Some(pe) = trusted_pe() else {
+        eprintln!("SKIP: local-only fixture myron-global-302.efi absent");
+        return;
+    };
+    assert_eq!(sha256(&pe), gblp1::sha256(&pe));
+
+    for len in [0usize, 1, 55, 56, 57, 63, 64, 65, 127, 128, 129] {
+        let data: Vec<u8> = (0..len).map(|i| (i % 251) as u8).collect();
+        assert_eq!(sha256(&data), gblp1::sha256(&data), "len={len}");
+    }
+
+    // RFC 6234 test vector: SHA-256("abc").
+    let abc = b"abc";
+    assert_eq!(
+        sha256(abc),
+        hex_to_bytes("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
+    );
+}
+
+fn hex_to_bytes(hex: &str) -> [u8; 32] {
+    let mut out = [0u8; 32];
+    for i in 0..32 {
+        out[i] = u8::from_str_radix(&hex[i * 2..i * 2 + 2], 16).unwrap();
+    }
+    out
+}
+
+#[test]
+fn trusted_global_302_source_accepted() {
+    let Some(pe) = trusted_pe() else {
+        eprintln!("SKIP: local-only fixture myron-global-302.efi absent");
+        return;
+    };
+    assert_eq!(verify_source_identity(&pe), VerifyStatus::Ok);
+}
+
+#[test]
+fn one_byte_mutation_rejected() {
+    let Some(mut pe) = trusted_pe() else {
+        eprintln!("SKIP: local-only fixture myron-global-302.efi absent");
+        return;
+    };
+    // Flip a byte in the middle of the image (well past any header).
+    let idx = pe.len() / 2;
+    pe[idx] ^= 0x01;
+    assert_eq!(verify_source_identity(&pe), VerifyStatus::SourceIdentityMismatch);
+
+    // Also a leading-byte mutation (header region).
+    let mut head = pe.clone();
+    head[0] ^= 0xff;
+    assert_eq!(verify_source_identity(&head), VerifyStatus::SourceIdentityMismatch);
+
+    // And a trailing-byte mutation.
+    let mut tail = pe.clone();
+    let last = tail.len() - 1;
+    tail[last] ^= 0x01;
+    assert_eq!(verify_source_identity(&tail), VerifyStatus::SourceIdentityMismatch);
+}
+
+#[test]
+fn wrong_firmware_rejected() {
+    let (Some(other), Some(trusted)) = (other_firmware_pe(), trusted_pe()) else {
+        eprintln!("SKIP: local-only fixtures absent");
+        return;
+    };
+    // Sanity: it is a real, non-empty PE image — not the trusted identity.
+    assert!(!other.is_empty());
+    assert_ne!(sha256(&other), sha256(&trusted));
+    assert_eq!(verify_source_identity(&other), VerifyStatus::SourceIdentityMismatch);
+}
+
+#[test]
+fn truncated_or_malformed_input_rejected() {
+    let Some(pe) = trusted_pe() else {
+        eprintln!("SKIP: local-only fixture myron-global-302.efi absent");
+        return;
+    };
+
+    // Empty input is malformed, not merely a hash mismatch.
+    assert_eq!(verify_source_identity(&[]), VerifyStatus::InvalidInput);
+
+    // A strict prefix of the trusted PE is non-empty but has a different
+    // digest — it must fail closed as an identity mismatch, never Ok.
+    for cut in [1usize, 64, pe.len() / 2, pe.len() - 1] {
+        assert_eq!(
+            verify_source_identity(&pe[..cut]),
+            VerifyStatus::SourceIdentityMismatch,
+            "truncated to {cut} bytes"
+        );
+    }
+
+    // An all-zero buffer of the same length is a malformed stand-in.
+    let zeros = vec![0u8; pe.len()];
+    assert_eq!(verify_source_identity(&zeros), VerifyStatus::SourceIdentityMismatch);
+}
+
+#[test]
+fn no_patch_writes_after_identity_failure() {
+    // The Tier 2 contract: the identity gate runs before any patch write. On a
+    // failed identity check the caller must not invoke the patch engine, so the
+    // buffer is left exactly as it was received (unmodified).
+    let Some(mut pe) = trusted_pe() else {
+        eprintln!("SKIP: local-only fixture myron-global-302.efi absent");
+        return;
+    };
+    let mut bad = pe.clone();
+    let idx = bad.len() / 3;
+    bad[idx] ^= 0x01;
+    let snapshot = bad.clone();
+
+    assert_eq!(verify_source_identity(&bad), VerifyStatus::SourceIdentityMismatch);
+
+    // Because identity failed, no patch is applied: buffer is byte-identical to
+    // the (already-mutated) input. This is what BootFlow.c enforces by
+    // returning EFI_NOT_READY before DynamicPatch_Apply.
+    assert_eq!(bad, snapshot);
+
+    // Contrast: the trusted image passes the gate and is eligible for patching.
+    let good = pe;
+    assert_eq!(verify_source_identity(&good), VerifyStatus::Ok);
+}
+
+#[test]
+fn ffi_boundary_propagates_failure() {
+    let Some(pe) = trusted_pe() else {
+        eprintln!("SKIP: local-only fixture myron-global-302.efi absent");
+        return;
+    };
+
+    // Trusted bytes accepted through the C ABI.
+    assert_eq!(
+        unsafe { DynamicPatch_VerifySourceIdentity(pe.as_ptr(), pe.len() as u32) },
+        VerifyStatus::Ok
+    );
+
+    // Null pointer / zero size are rejected before any read (fail-closed).
+    assert_eq!(
+        unsafe { DynamicPatch_VerifySourceIdentity(core::ptr::null(), 0) },
+        VerifyStatus::InvalidInput
+    );
+    assert_eq!(
+        unsafe { DynamicPatch_VerifySourceIdentity(core::ptr::null(), pe.len() as u32) },
+        VerifyStatus::InvalidInput
+    );
+    assert_eq!(
+        unsafe { DynamicPatch_VerifySourceIdentity(pe.as_ptr(), 0) },
+        VerifyStatus::InvalidInput
+    );
+
+    // A one-byte mutation propagates as an identity mismatch through the ABI.
+    // Clone so `pe` stays valid for the truncated-view assertion below.
+    let mut bad = pe.clone();
+    bad[1024] ^= 0x01;
+    assert_eq!(
+        unsafe { DynamicPatch_VerifySourceIdentity(bad.as_ptr(), bad.len() as u32) },
+        VerifyStatus::SourceIdentityMismatch
+    );
+
+    // A truncated view propagates as an identity mismatch.
+    assert_eq!(
+        unsafe { DynamicPatch_VerifySourceIdentity(pe.as_ptr(), 64) },
+        VerifyStatus::SourceIdentityMismatch
+    );
+}
