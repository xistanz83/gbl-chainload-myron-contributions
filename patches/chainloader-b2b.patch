+
+extern __attribute__((visibility("default"))) int printf(const char *, ...);
+extern __attribute__((visibility("default"))) void *malloc(unsigned long);
+extern __attribute__((visibility("default"))) void free(void *);
+extern __attribute__((visibility("default"))) void exit(int);
+static void zero(void *p, unsigned long n) { unsigned char *q=p; while(n--) *q++=0; }
+#define CHECK(x) do { if (!(x)) {printf("line %d: %s\n",__LINE__,#x); exit(1);} } while (0)
+EFI_BOOT_SERVICES services;
+EFI_RUNTIME_SERVICES runtime;
+EFI_BOOT_SERVICES *gBS=&services;
+EFI_RUNTIME_SERVICES *gRT=&runtime;
+EFI_USB_DEVICE_QUALIFIER_DESCRIPTOR DeviceQualifier;
+EFI_USB_STRING_DESCRIPTOR *StrDescriptors[5];
+BOOLEAN GblFastbootEscapePending, GblFastbootEspBootPending;
+static EFI_USB_DEVICE_PROTOCOL usb;
+static int frees, pools, events, after_stop, stopped, uninit, finished, escape_calls, esp_calls, event_command;
+static EFI_STATUS free_status=EFI_SUCCESS;
+static void *tx, *rx;
+VOID EFIAPI DebugPrint(UINTN l, CONST CHAR8 *f, ...) {(void)l;(void)f;}
+BOOLEAN EFIAPI DebugPrintEnabled(VOID) {return FALSE;}
+VOID EFIAPI FreePool(VOID *p) {CHECK(p);pools++;free(p);}
+static EFI_STATUS EFIAPI free_transfer(VOID *p) {
+  CHECK(p); if (stopped) after_stop++; frees++;
+  if (EFI_ERROR(free_status)) return free_status;
+  free(p); return EFI_SUCCESS;
+}
+static EFI_STATUS EFIAPI alloc_transfer(UINTN n, VOID **p) {*p=malloc(n); CHECK(*p); if (!rx) rx=*p; else tx=*p; return EFI_SUCCESS;}
+static EFI_STATUS EFIAPI start_usb(USB_DEVICE_DESCRIPTOR_SET *p) {(void)p; return EFI_SUCCESS;}
+static EFI_STATUS EFIAPI handle_event(USB_DEVICE_EVENT *e, UINTN *sz, USB_DEVICE_EVENT_DATA *data) {
+ (void)sz; events++; if(stopped) after_stop++; if (event_command) {*e=UsbDeviceEventTransferNotification;data->TransferOutcome.EndpointIndex=1;data->TransferOutcome.Status=UsbDeviceTransferStatusCompleteOK;data->TransferOutcome.BytesCompleted=1;} else {*e=UsbDeviceEventDeviceStateChange;data->DeviceState=UsbDeviceStateDisconnected;} return EFI_SUCCESS;
+}
+static EFI_STATUS EFIAPI create_event(UINT32 t, EFI_TPL tpl, EFI_EVENT_NOTIFY fn, CONST VOID *ctx, CONST EFI_GUID *group, EFI_EVENT *e) {(void)t;(void)tpl;(void)fn;(void)ctx;(void)group;*e=(EFI_EVENT)1;return EFI_SUCCESS;}
+static EFI_STATUS EFIAPI event_ok(EFI_EVENT e) {(void)e;return EFI_SUCCESS;}
+static EFI_STATUS EFIAPI locate(EFI_GUID *g, VOID *r, VOID **p) {(void)g;(void)r;*p=&usb;return EFI_SUCCESS;}
+static EFI_STATUS EFIAPI get_variable(CHAR16 *n, EFI_GUID *g, UINT32 *a, UINTN *s, VOID *d) {(void)n;(void)g;(void)a;(void)s;(void)d;return EFI_NOT_FOUND;}
+VOID BuildDefaultDescriptors(USB_DEVICE_DESCRIPTOR **d, VOID **p, USB_DEVICE_DESCRIPTOR **sd, VOID **sp) {static USB_DEVICE_DESCRIPTOR one;*d=&one;*sd=&one;*p=malloc(8);*sp=malloc(8);CHECK(*p && *sp);}
+BOOLEAN IsLEVariant(VOID) {return FALSE;}
+MemCardType CheckRootDeviceType(VOID) {return 0;}
+VOID BootStatsSetTimeStamp(BS_ENTRY e) {(void)e;}
+VOID DisplayFastbootMenu(VOID) {}
+VOID StoreRootDeviceType(VOID) {}
+VOID ExitMenuKeysDetection(VOID) {}
+EFI_STATUS FastbootCmdsInit(VOID) {return EFI_SUCCESS;}
+EFI_STATUS FastbootCmdsUnInit(VOID) {uninit++;stopped=1;return EFI_SUCCESS;}
+BOOLEAN FastbootFatal(VOID) {return finished;}
+ANDROID_FASTBOOT_STATE FastbootCurrentState(VOID) {return ExpectCmdState;}
+VOID *FastbootDloadBuffer(VOID) {return NULL;}
+UINTN GetXfrSize(VOID) {return 0;}
+VOID DataReady(UINT64 n, VOID *p) {(void)n;(void)p; if (event_command) {finished=1;CHECK(FastbootUsbDeviceStop()==EFI_SUCCESS);}}
+EFI_STATUS GblFastbootEscapeToBootFlow(VOID) {escape_calls++;finished=1;CHECK(FastbootUsbDeviceStop()==EFI_SUCCESS);return EFI_DEVICE_ERROR;}
+EFI_STATUS GblFastbootEspBootDeferred(VOID) {esp_calls++;return EFI_SUCCESS;}
+static void setup(void) {
+ zero(&services,sizeof services);zero(&runtime,sizeof runtime);zero(&usb,sizeof usb);
+ services.CreateEventEx=create_event;services.SignalEvent=event_ok;services.CloseEvent=event_ok;services.LocateProtocol=locate;
+ runtime.GetVariable=get_variable;usb.FreeTransferBuffer=free_transfer;usb.AllocateTransferBuffer=alloc_transfer;usb.StartEx=start_usb;usb.HandleEvent=handle_event;
+ frees=pools=events=after_stop=stopped=uninit=finished=escape_calls=esp_calls=event_command=0; UsbCleanupStatus=EFI_SUCCESS;free_status=EFI_SUCCESS;tx=rx=NULL;GblFastbootEscapePending=GblFastbootEspBootPending=FALSE;
+ zero(&Fbd,sizeof Fbd);zero(&DescSet,sizeof DescSet);
+}
+static void test_cleanup(void) {
+ setup(); Fbd.UsbDeviceProtocol=&usb;Fbd.gTxBuffer=tx=malloc(32);Fbd.gRxBuffer=rx=malloc(32);DescSet.Descriptors=malloc(8);DescSet.SSDescriptors=malloc(8);
+ CHECK(FastbootUsbDeviceStop()==EFI_SUCCESS);CHECK(frees==2 && pools==2);CHECK(!Fbd.gTxBuffer && !Fbd.gRxBuffer && !DescSet.Descriptors && !DescSet.SSDescriptors);
+ CHECK(FastbootUsbDeviceStop()==EFI_SUCCESS);CHECK(frees==2 && pools==2);
+}
+static void test_escape_return(void) {
+ setup();GblFastbootEscapePending=GblFastbootEspBootPending=TRUE;
+ CHECK(FastbootInitialize()==EFI_SUCCESS);CHECK(escape_calls==1 && esp_calls==0);CHECK(events==1);CHECK(frees==2 && pools==2);CHECK(uninit==1 && !after_stop);
+}
+static void test_command_return(void) {
+ setup();event_command=1;
+ CHECK(FastbootInitialize()==EFI_SUCCESS);CHECK(events==1);CHECK(frees==2 && pools==2);CHECK(uninit==1 && !after_stop);
+}
+static void test_failed_release(void) {
+ setup();Fbd.UsbDeviceProtocol=&usb;Fbd.gTxBuffer=tx=malloc(32);Fbd.gRxBuffer=rx=malloc(32);DescSet.Descriptors=malloc(8);free_status=EFI_DEVICE_ERROR;
+ CHECK(FastbootUsbDeviceStop()==EFI_DEVICE_ERROR);CHECK(frees==2 && pools==1);CHECK(!Fbd.gTxBuffer && !Fbd.gRxBuffer && !DescSet.Descriptors);
+ free_status=EFI_SUCCESS;CHECK(FastbootUsbDeviceStop()==EFI_DEVICE_ERROR);CHECK(frees==2);free(tx);free(rx);
+}
+static void test_partial_cleanup(void) {
+ setup();Fbd.UsbDeviceProtocol=&usb;Fbd.gRxBuffer=rx=malloc(32);DescSet.SSDescriptors=malloc(8);
+ CHECK(FastbootUsbDeviceStop()==EFI_SUCCESS);CHECK(frees==1 && pools==1);CHECK(FastbootUsbDeviceStop()==EFI_SUCCESS);CHECK(frees==1 && pools==1);
+}
+int main(void) {test_cleanup();test_partial_cleanup();test_failed_release();test_escape_return();test_command_return();printf("Fastboot production Main.c lifecycle mocks passed\n");return 0;}
diff --git a/tests/host/hook_rollback/hook_blockio_test.c b/tests/host/hook_rollback/hook_blockio_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..b8aeaf4860fb879403be3cd30e5ff609e5c48e63
--- /dev/null
+++ b/tests/host/hook_rollback/hook_blockio_test.c
@@ -0,0 +1,433 @@
+/* hook_blockio_test.c — host white-box regression test for the PRODUCTION
+ * GblChainloadPkg/Library/ProtocolHookLib/BlockIoHook.c (Phase B1).
+ *
+ * Technique: the production source is #included UNMODIFIED into this
+ * translation unit, compiled against a minimal mocked UEFI environment
+ * (programmable gBS handle table, mock protocol structs) plus the REAL
+ * HookCommon.h and REAL ProtocolHookLib.h from the worktree. White-box
+ * access to file-scope statics (HookedReadBlocks/HookedWriteBlocks,
+ * record tables) is what makes the untracked-wrapper and foreign-ownership
+ * scenarios expressible at all — a separate-TU test could not name those
+ * static symbols.
+ *
+ * Coverage notes / limitations:
+ *  - DEBUG/VERBOSE/GBL_INFO/Print are compiled out: telemetry format
+ *    strings are NOT validated here.
+ *  - No SMP/preemption is modeled (matches the firmware execution model
+ *    the production comments rely on).
+ *  - gBS calls are synchronous and never fail unless programmed to.
+ *
+ * Build: see run.sh in this directory.
+ */
+
+#include <Uefi.h>
+#include <Uefi/UefiGpt.h>
+#include <Library/BaseLib.h>
+#include <Library/BaseMemoryLib.h>
+#include <Library/DebugLib.h>
+#include <Library/GblLog.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include <Library/UefiLib.h>
+#include <Protocol/BlockIo.h>
+
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+
+/* ------------------------------------------------------------------ */
+/* Mock base-library definitions                                       */
+/* ------------------------------------------------------------------ */
+
+INTN AsciiStrCmp (IN CONST CHAR8 *Dest, IN CONST CHAR8 *Src)
+{
+  return (INTN)strcmp (Dest, Src);
+}
+
+VOID ZeroMem (OUT VOID *Buffer, IN UINTN Length)
+{
+  memset (Buffer, 0, Length);
+}
+
+VOID CopyMem (OUT VOID *Destination, IN CONST VOID *Source, IN UINTN Length)
+{
+  memcpy (Destination, Source, Length);
+}
+
+VOID MemoryFence (VOID)
+{
+  /* no-op on the host; the firmware build uses the real BaseLib fence */
+}
+
+VOID Print (IN CONST CHAR16 *Fmt, ...)
+{
+  (void) Fmt;
+  fputs ("[Print]\n", stdout);
+}
+
+/* ------------------------------------------------------------------ */
+/* Mock gBS: programmable device table                                 */
+/* ------------------------------------------------------------------ */
+
+EFI_GUID gEfiBlockIoProtocolGuid    = { 0xB1000001, 0, 0, { 0 } };
+EFI_GUID gEfiPartitionRecordGuid    = { 0xB1000002, 0, 0, { 0 } };
+
+#define MAX_MOCK_DEVS 8
+
+typedef struct {
+  EFI_HANDLE              Handle;
+  CHAR16                  Name[36];   /* empty => no partition record */
+  EFI_BLOCK_IO_PROTOCOL  *Bio;        /* NULL  => no BlockIo protocol */
+} MOCK_DEV;
+
+STATIC MOCK_DEV              gDevs[MAX_MOCK_DEVS];
+STATIC UINTN                 gDevCount = 0;
+STATIC EFI_PARTITION_ENTRY   gParts[MAX_MOCK_DEVS];
+STATIC EFI_TPL               gTpl = TPL_APPLICATION;
+STATIC UINTN                 gFreePoolCalls = 0;
+
+EFI_STATUS EFIAPI MockLocateHandleBuffer (
+  IN EFI_HANDLE    ImageHandle,
+  IN EFI_GUID      *Protocol,
+  IN VOID          **SearchOption,
+  OUT UINTN        *BufferLen,
+  OUT EFI_HANDLE  **Buffers
+  )
+{
+  UINTN I, N = 0, J = 0;
+
+  (void) ImageHandle; (void) Protocol; (void) SearchOption;
+  for (I = 0; I < gDevCount; I++) {
+    if (gDevs[I].Bio != NULL) N++;
+  }
+  *Buffers = (EFI_HANDLE *)malloc (((N > 0) ? N : 1) * sizeof (EFI_HANDLE));
+  if (*Buffers == NULL) return EFI_OUT_OF_RESOURCES;
+  for (I = 0; I < gDevCount; I++) {
+    if (gDevs[I].Bio != NULL) (*Buffers)[J++] = gDevs[I].Handle;
+  }
+  *BufferLen = N;
+  return EFI_SUCCESS;
+}
+
+EFI_STATUS EFIAPI MockHandleProtocol (
+  IN EFI_HANDLE  Handle,
+  IN EFI_GUID    *Protocol,
+  OUT VOID      **Interface
+  )
+{
+  UINTN I;
+
+  for (I = 0; I < gDevCount; I++) {
+    if (gDevs[I].Handle != Handle) continue;
+    if (Protocol == &gEfiPartitionRecordGuid) {
+      if (gDevs[I].Name[0] == L'\0') return EFI_UNSUPPORTED;
+      *Interface = &gParts[I];
+      return EFI_SUCCESS;
+    }
+    if (Protocol == &gEfiBlockIoProtocolGuid) {
+      if (gDevs[I].Bio == NULL) return EFI_UNSUPPORTED;
+      *Interface = gDevs[I].Bio;
+      return EFI_SUCCESS;
+    }
+  }
+  return EFI_UNSUPPORTED;
+}
+
+VOID EFIAPI MockFreePool (IN VOID *Buffer)
+{
+  (void) Buffer;
+  gFreePoolCalls++;
+}
+
+EFI_TPL EFIAPI MockRaiseTPL (IN EFI_TPL NewTpl)
+{
+  EFI_TPL Old = gTpl;
+  if (NewTpl < gTpl) gTpl = NewTpl;   /* UEFI: numerically lower = higher TPL */
+  return Old;
+}
+
+VOID EFIAPI MockRestoreTPL (IN EFI_TPL OldTpl)
+{
+  gTpl = OldTpl;
+}
+
+STATIC MOCK_EFI_BOOT_SERVICES gMockBsTable = {
+  MockLocateHandleBuffer, MockHandleProtocol, MockFreePool,
+  MockRaiseTPL, MockRestoreTPL
+};
+MOCK_EFI_BOOT_SERVICES *gBS = &gMockBsTable;
+
+/* ------------------------------------------------------------------ */
+/* ORIGINAL (unhooked) BlockIo implementations used as test fixtures  */
+/* ------------------------------------------------------------------ */
+
+STATIC int gOrigReadCalls = 0;
+STATIC int gOrigWriteCalls = 0;
+
+EFI_STATUS EFIAPI OrigReadBlocks (
+  IN EFI_BLOCK_IO_PROTOCOL *This, IN UINT32 MediaId,
+  IN EFI_LBA Lba, IN UINTN BufferSize, OUT VOID *Buffer
+  )
+{
+  (void) This; (void) MediaId; (void) Lba; (void) BufferSize; (void) Buffer;
+  gOrigReadCalls++;
+  return EFI_SUCCESS;
+}
+
+EFI_STATUS EFIAPI OrigWriteBlocks (
+  IN EFI_BLOCK_IO_PROTOCOL *This, IN UINT32 MediaId,
+  IN EFI_LBA Lba, IN UINTN BufferSize, IN VOID *Buffer
+  )
+{
+  (void) This; (void) MediaId; (void) Lba; (void) BufferSize; (void) Buffer;
+  gOrigWriteCalls++;
+  return EFI_SUCCESS;
+}
+
+/* A third, foreign implementation: not ours, not the original. */
+EFI_STATUS EFIAPI ForeignWriteBlocks (
+  IN EFI_BLOCK_IO_PROTOCOL *This, IN UINT32 MediaId,
+  IN EFI_LBA Lba, IN UINTN BufferSize, IN VOID *Buffer
+  )
+{
+  (void) This; (void) MediaId; (void) Lba; (void) BufferSize; (void) Buffer;
+  return EFI_SUCCESS;
+}
+
+/* ------------------------------------------------------------------ */
+/* THE PRODUCTION SOURCE, UNMODIFIED                                   */
+/* ------------------------------------------------------------------ */
+
+#include "BlockIoHook.c"
+
+/* ------------------------------------------------------------------ */
+/* Test harness                                                        */
+/* ------------------------------------------------------------------ */
+
+STATIC int gPass = 0;
+STATIC int gFail = 0;
+
+#define CHECK(cond, msg)                                          \
+  do {                                                            \
+    if (cond) { gPass++; printf ("  PASS: %s\n", msg); }          \
+    else      { gFail++; printf ("  FAIL: %s\n", msg); }          \
+  } while (0)
+
+STATIC UINTN gBioPoolIndex = 0;
+
+/* White-box reset of all production file-scope state. */
+STATIC void ResetBlockIoState (void)
+{
+  ZeroMem (gBlockIoRecords, sizeof (gBlockIoRecords));
+  gBlockIoRecordCount = 0;
+  gBlockIoUntracked   = FALSE;
+  gBlockIoUnresolved  = FALSE;
+  ZeroMem (gBlockIoCandidates, sizeof (gBlockIoCandidates));
+  gBlockIoInstallActive = FALSE;
+}
+
+STATIC void ResetDevices (void)
+{
+  gDevCount = 0;
+  gBioPoolIndex = 0;
+  ZeroMem (gDevs, sizeof (gDevs));
+  ZeroMem (gParts, sizeof (gParts));
+  gFreePoolCalls = 0;
+}
+
+/* ASCII in, CHAR16 out: host wchar_t is 32-bit here, so L"" literals do
+ * not match the 16-bit CHAR16 the production code uses. */
+STATIC EFI_HANDLE AddDevice (const char *Name, EFI_BLOCK_IO_PROTOCOL *Bio)
+{
+  UINTN I = gDevCount++;
+
+  gDevs[I].Handle = (EFI_HANDLE)(0x1000 + I);
+  gDevs[I].Bio    = Bio;
+  if (Name != NULL) {
+    UINTN N = 0;
+    while (Name[N] != '\0' && N < 35) { gDevs[I].Name[N] = (CHAR16)Name[N]; N++; }
+    gDevs[I].Name[N] = L'\0';
+    CopyMem (gParts[I].PartitionName, gDevs[I].Name,
+             sizeof (gParts[I].PartitionName));
+  }
+  return gDevs[I].Handle;
+}
+
+STATIC EFI_BLOCK_IO_PROTOCOL *MakeBio (UINT64 LastBlock, UINT32 BlockSize,
+                                       EFI_BLOCK_READ R, EFI_BLOCK_WRITE W)
+{
+  STATIC EFI_BLOCK_IO_MEDIA MediaPool[MAX_MOCK_DEVS];
+  STATIC EFI_BLOCK_IO_PROTOCOL BioPool[MAX_MOCK_DEVS];
+  UINTN I = gBioPoolIndex++;   /* distinct slot per bio, independent of devices */
+
+  MediaPool[I].MediaPresent = TRUE;
+  MediaPool[I].LastBlock    = LastBlock;
+  MediaPool[I].BlockSize    = BlockSize;
+  BioPool[I].Media          = &MediaPool[I];
+  BioPool[I].ReadBlocks     = R;
+  BioPool[I].WriteBlocks    = W;
+  return &BioPool[I];
+}
+
+int main (void)
+{
+  EFI_STATUS           Status;
+  HOOK_UNINSTALL_RESULT Result;
+  EFI_BLOCK_IO_PROTOCOL *bio0, *bio1, *bioX;
+
+  printf ("== B1 BlockIoHook white-box regression (production source) ==\n");
+
+  /* ---------------- Scenario 1: clean install + cleanup ------------- */
+  printf ("S1: successful installation and cleanup\n");
+  ResetDevices (); ResetBlockIoState ();
+  bio0 = MakeBio (1000, 512, OrigReadBlocks, OrigWriteBlocks);
+  bio1 = MakeBio (2000, 512, OrigReadBlocks, OrigWriteBlocks);
+  AddDevice ("oplusreserve1", bio0);
+  AddDevice ("userdata",      bio1);
+
+  Status = InstallBlockIoHook ();
+  CHECK (Status == EFI_SUCCESS,
+         "InstallBlockIoHook returns EFI_SUCCESS");
+  CHECK (bio0->ReadBlocks == HookedReadBlocks &&
+         bio0->WriteBlocks == HookedWriteBlocks,
+         "reserve slots wrapped");
+  CHECK (bio1->ReadBlocks == HookedReadBlocks &&
+         bio1->WriteBlocks == HookedWriteBlocks,
+         "userdata slots wrapped");
+
+  Result = UninstallBlockIoHook ();
+  CHECK (Result == HOOK_UNINSTALLED, "UninstallBlockIoHook returns HOOK_UNINSTALLED");
+  CHECK (bio0->ReadBlocks == OrigReadBlocks &&
+         bio0->WriteBlocks == OrigWriteBlocks,
+         "reserve slots restored to originals");
+  CHECK (bio1->ReadBlocks == OrigReadBlocks &&
+         bio1->WriteBlocks == OrigWriteBlocks,
+         "userdata slots restored to originals");
+
+  /* ---------------- Scenario 2: repeated uninstall ------------------- */
+  printf ("S2: repeated uninstall\n");
+  Result = UninstallBlockIoHook ();
+  CHECK (Result == HOOK_UNINSTALLED, "second uninstall returns HOOK_UNINSTALLED");
+  CHECK (bio0->ReadBlocks == OrigReadBlocks &&
+         bio0->WriteBlocks == OrigWriteBlocks &&
+         bio1->ReadBlocks == OrigReadBlocks &&
+         bio1->WriteBlocks == OrigWriteBlocks,
+         "slots unchanged after repeated uninstall");
+
+  /* ---------------- Bonus: reinstall after clean uninstall ----------- */
+  printf ("S7: reinstall after clean uninstall (retained-record path)\n");
+  Status = InstallBlockIoHook ();
+  CHECK (Status == EFI_SUCCESS, "reinstall returns EFI_SUCCESS");
+  Result = UninstallBlockIoHook ();
+  CHECK (Result == HOOK_UNINSTALLED, "post-reinstall uninstall is clean");
+
+  /* ---------------- Scenario 3: conflicting labels ------------------- */
+  printf ("S3: shared interface, conflicting partition labels\n");
+  ResetDevices (); ResetBlockIoState ();
+  bioX = MakeBio (1000, 512, OrigReadBlocks, OrigWriteBlocks);
+  AddDevice ("oplusreserve1", bioX);   /* two handles, ONE interface */
+  AddDevice ("userdata",      bioX);
+
+  Status = InstallBlockIoHook ();
+  CHECK (Status == EFI_SECURITY_VIOLATION,
+         "conflicting labels return EFI_SECURITY_VIOLATION");
+  CHECK (bioX->ReadBlocks == OrigReadBlocks &&
+         bioX->WriteBlocks == OrigWriteBlocks,
+         "zero slot mutations on conflicting-label failure");
+  Result = UninstallBlockIoHook ();
+  CHECK (Result == HOOK_NOT_INSTALLED,
+         "nothing installed => HOOK_NOT_INSTALLED (not a false-clean of hooks)");
+
+  /* ---------------- Scenario 4: untracked wrapper -------------------- */
+  printf ("S4: untracked wrapper (no record, our wrapper in slot)\n");
+  ResetDevices (); ResetBlockIoState ();
+  bio0 = MakeBio (1000, 512, HookedReadBlocks, OrigWriteBlocks); /* white-box */
+  AddDevice ("oplusreserve1", bio0);
+
+  Status = InstallBlockIoHook ();
+  CHECK (Status == EFI_DEVICE_ERROR,
+         "install with untracked wrapper returns EFI_DEVICE_ERROR");
+  Result = UninstallBlockIoHook ();
+  CHECK (Result == HOOK_UNRESOLVED, "untracked wrapper => HOOK_UNRESOLVED");
+  CHECK (bio0->ReadBlocks == HookedReadBlocks,
+         "untracked wrapper left in place (not overwritten by us)");
+
+  /* ---------------- Scenario 5: foreign ownership -------------------- */
+  printf ("S5: foreign function-pointer ownership after install\n");
+  ResetDevices (); ResetBlockIoState ();
+  bio0 = MakeBio (1000, 512, OrigReadBlocks, OrigWriteBlocks);
+  bio1 = MakeBio (2000, 512, OrigReadBlocks, OrigWriteBlocks);
+  AddDevice ("oplusreserve1", bio0);
+  AddDevice ("userdata",      bio1);
+  Status = InstallBlockIoHook ();
+  CHECK (Status == EFI_SUCCESS, "precondition: clean install");
+
+  bio0->WriteBlocks = ForeignWriteBlocks;   /* someone else took the slot */
+
+  Result = UninstallBlockIoHook ();
+  CHECK (Result == HOOK_UNRESOLVED, "foreign-owned slot => HOOK_UNRESOLVED");
+  CHECK (bio0->WriteBlocks == ForeignWriteBlocks,
+         "foreign pointer NOT overwritten by uninstall");
+  CHECK (bio0->ReadBlocks == OrigReadBlocks,
+         "our owned read slot still restored");
+  CHECK (bio1->ReadBlocks == OrigReadBlocks &&
+         bio1->WriteBlocks == OrigWriteBlocks,
+         "other partition fully restored");
+
+  /* ---------------- Scenario 6: missing reserve partition ------------ */
+  printf ("S6: no oplus/oppo reserve1 partition present\n");
+  ResetDevices (); ResetBlockIoState ();
+  bio1 = MakeBio (2000, 512, OrigReadBlocks, OrigWriteBlocks);
+  AddDevice ("userdata", bio1);
+
+  Status = InstallBlockIoHook ();
+  CHECK (Status == EFI_NOT_FOUND,
+         "missing reserve partition returns EFI_NOT_FOUND");
+  Result = UninstallBlockIoHook ();
+  CHECK (Result == HOOK_NOT_INSTALLED, "nothing installed => HOOK_NOT_INSTALLED");
+
+  /* ---------------- Scenario 8: EFISP protected access ------------- */
+  printf ("S8: EFISP partition access refused (protected Block I/O)\n");
+  ResetDevices (); ResetBlockIoState ();
+  bio0 = MakeBio (1000, 512, OrigReadBlocks, OrigWriteBlocks);   /* reserve */
+  bio1 = MakeBio (4096, 512, OrigReadBlocks, OrigWriteBlocks);   /* efisp   */
+  bioX = MakeBio (2000, 512, OrigReadBlocks, OrigWriteBlocks);   /* userdata*/
+  AddDevice ("oplusreserve1", bio0);
+  AddDevice ("efisp",         bio1);
+  AddDevice ("userdata",      bioX);
+
+  Status = InstallBlockIoHook ();
+  CHECK (Status == EFI_SUCCESS,
+         "install with efisp partition returns EFI_SUCCESS");
+  CHECK (bio1->ReadBlocks == HookedReadBlocks &&
+         bio1->WriteBlocks == HookedWriteBlocks,
+         "efisp slots wrapped");
+
+  gOrigReadCalls = 0; gOrigWriteCalls = 0;
+  Status = bio1->ReadBlocks (bio1, 1, 0, 512, NULL);
+  CHECK (Status == EFI_NO_MEDIA, "EFISP read refused with EFI_NO_MEDIA");
+  CHECK (gOrigReadCalls == 0,
+         "EFISP read never reached original implementation");
+
+  Status = bio1->WriteBlocks (bio1, 1, 0, 512, NULL);
+  CHECK (Status == EFI_NO_MEDIA, "EFISP write refused with EFI_NO_MEDIA");
+  CHECK (gOrigWriteCalls == 0,
+         "EFISP write never reached original implementation");
+
+  /* Control: a non-EFISP partition must still pass through. */
+  gOrigReadCalls = 0; gOrigWriteCalls = 0;
+  Status = bioX->ReadBlocks (bioX, 1, 5, 512, NULL);
+  CHECK (Status == EFI_SUCCESS && gOrigReadCalls == 1,
+         "userdata read passes through to original");
+  Status = bioX->WriteBlocks (bioX, 1, 5, 512, NULL);
+  CHECK (Status == EFI_SUCCESS && gOrigWriteCalls == 1,
+         "userdata write passes through to original");
+
+  Result = UninstallBlockIoHook ();
+  CHECK (Result == HOOK_UNINSTALLED, "post-EFISP uninstall is clean");
+  CHECK (bio1->ReadBlocks == OrigReadBlocks &&
+         bio1->WriteBlocks == OrigWriteBlocks,
+         "efisp slots restored to originals");
+
+  printf ("\n== RESULT: %d passed, %d failed ==\n", gPass, gFail);
+  return (gFail == 0) ? 0 : 1;
+}
