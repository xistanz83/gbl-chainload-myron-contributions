+    } else if (Now->SPSSDxe_ShareKeyMintInfo == gOrigShareKeyMintInfo) {
+      gSpssSlotState = HOOK_SLOT_RESTORED;
+    } else {
+      gSpssSlotState = HOOK_SLOT_FOREIGN;
+    }
+  } else if (gSpssSlotState == HOOK_SLOT_FOREIGN) {
+    if (Now->SPSSDxe_ShareKeyMintInfo == HookedShareKeyMintInfo)
+      gSpssSlotState = HOOK_SLOT_OWNED;
+    else if (Now->SPSSDxe_ShareKeyMintInfo == gOrigShareKeyMintInfo)
+      gSpssSlotState = HOOK_SLOT_RESTORED;
+  } else if (gSpssSlotState == HOOK_SLOT_RESTORED) {
+    if (Now->SPSSDxe_ShareKeyMintInfo != gOrigShareKeyMintInfo)
+      gSpssSlotState = HOOK_SLOT_FOREIGN;
+  } else if (gSpssSlotState == HOOK_SLOT_ABSENT ||
+             gSpssSlotState == HOOK_SLOT_STOCK) {
+    if (Now->SPSSDxe_ShareKeyMintInfo != gOrigShareKeyMintInfo)
+      gSpssSlotState = HOOK_SLOT_FOREIGN;
+  } else {
+    gSpssSlotState = HOOK_SLOT_FOREIGN;
+  }
