+  RESOLVE_QSEE_SLOT (gQseeSendState, Now->QseecomSendCmd,
+                     gOriginalSendCmd, HookedSendCmd);
+  RESOLVE_QSEE_SLOT (gQseeStartState, Now->QseecomStartApp,
+                     gOriginalStartApp, HookedStartApp);
+  /* Final observation, not only the historical RESTORED state, decides. */
+  if (Now->QseecomStartApp != gOriginalStartApp ||
+      Now->QseecomSendCmd != gOriginalSendCmd) {
+    gQseeUnresolved = TRUE;
+    return HOOK_UNRESOLVED;
+  }
+  if (gQseeStartState == HOOK_SLOT_OWNED ||
+      gQseeStartState == HOOK_SLOT_FOREIGN ||
+      gQseeSendState == HOOK_SLOT_OWNED ||
+      gQseeSendState == HOOK_SLOT_FOREIGN) {
+    gQseeUnresolved = TRUE;
+    return HOOK_UNRESOLVED;
+  }
