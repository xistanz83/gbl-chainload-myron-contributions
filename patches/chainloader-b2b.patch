+#!/usr/bin/env python3
+"""Compile the unchanged bodies of three production FastbootCmds functions with host mocks."""
+import os
+import pathlib
+import re
+import subprocess
+import tempfile
+
+root = pathlib.Path(__file__).resolve().parents[2]
+source = (root / 'edk2/QcomModulePkg/Library/FastbootLib/FastbootCmds.c').read_text()
+def function(name):
+    match = re.search(r'\n(?:STATIC VOID|EFI_STATUS)\s*\n' + name + r'\s*\(', source)
+    if not match:
+        raise RuntimeError('missing production function ' + name)
+    start = match.start() + 1
+    left = source.index('{', match.end())
+    depth = 1
+    i = left + 1
+    while depth:
+        if source[i] == '{': depth += 1
+        if source[i] == '}': depth -= 1
+        i += 1
+    return source[start:i]
+
+prefix = r'''
+#define _POSIX_C_SOURCE 200809L
+#include <assert.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <signal.h>
+#include <unistd.h>
+#include <sys/wait.h>
+#include <stdio.h>
+#include <string.h>
+#define STATIC static
+#define CONST const
+#define VOID void
+#define IN
+#define EFIAPI
+#define EFI_D_ERROR 0
+#define DEBUG(x) ((void)0)
+#define EFI_ERROR(x) ((x) != 0)
+#define EFI_SUCCESS 0
+#define TRUE 1
+#define FALSE 0
+#define MAX_RSP_SIZE 128
+#define GBL_STAGED_BUFFER_MAGIC 12
+#define GBL_STAGED_BUFFER_VERSION 1
+typedef int EFI_STATUS;
+typedef void *EFI_HANDLE;
+typedef uint64_t EFI_PHYSICAL_ADDRESS;
+typedef size_t UINTN;
+typedef uint32_t UINT32;
+typedef char CHAR8;
+typedef int BOOLEAN;
+static volatile sig_atomic_t Finished, starts;
+static int UnInitAttempted, UnInitStatus;
+static unsigned char data_buf[32];
+static unsigned char *mDataBuffer, *mUsbDataBuffer, *mFlashDataBuffer;
+static uint64_t mFlashNumDataBytes;
+static int gGblStagedBufferGuid;
+static struct { int Magic, Version; EFI_PHYSICAL_ADDRESS Base; UINTN Size; } gGblStagedBufferRecord;
+static EFI_HANDLE gImageHandle;
+static int frees, stops, loads, bootflows, info_count, okay_count, waits, release_count, fastboot_uninit;
+static int fail_release, fail_load, fail_data_free, fail_start;
+static EFI_STATUS free_transfer(VOID *p) { assert(p == data_buf); frees++; return fail_data_free ? 1 : 0; }
+static EFI_STATUS stop(void) { stops++; return 0; }
+static struct { EFI_STATUS (*FreeTransferBuffer)(VOID *); EFI_STATUS (*Stop)(void); } protocol = {free_transfer, stop};
+static struct { __typeof__(&protocol) UsbDeviceProtocol; } device = {&protocol};
+static __typeof__(&device) GetFastbootDeviceData(void) { return &device; }
+static EFI_STATUS FastbootUnInit(void) { fastboot_uninit++; return 0; }
+static void ExchangeFlashAndUsbDataBuf(void) { }
+static void FastbootFail(const CHAR8 *p) { (void)p; }
+static void FastbootInfo(const CHAR8 *p) { (void)p; info_count++; }
+static void FastbootOkay(const CHAR8 *p) { (void)p; okay_count++; }
+static void WaitForTransferComplete(void) { waits++; }
+static void ExitMenuKeysDetection(void) { }
+static EFI_STATUS FastbootUsbDeviceStop(void) { release_count++; assert(Finished); return fail_release ? 1 : 0; }
+static EFI_STATUS BootFlowChainLoad(void) { bootflows++; return 7; }
+#define AsciiSPrint(...) 0
+static EFI_STATUS install_table(void *guid, void *record) { (void)guid; (void)record; return 0; }
+static EFI_STATUS load_image(int b, EFI_HANDLE h, void *path, void *buffer, uint64_t size, EFI_HANDLE *out) {
+    (void)b; (void)h; (void)path; assert(buffer == data_buf && size == sizeof(data_buf)); loads++; *out = data_buf; return fail_load ? 1 : 0;
+}
+static void poison_bs(void);
+static EFI_STATUS start_image(EFI_HANDLE h, void *a, void *b) { (void)a; (void)b; assert(h == data_buf && Finished && release_count); starts++; poison_bs(); return fail_start ? 1 : 0; }
+static struct { EFI_STATUS (*InstallConfigurationTable)(void *, void *); EFI_STATUS (*LoadImage)(int,EFI_HANDLE,void *,void *,uint64_t,EFI_HANDLE *); EFI_STATUS (*StartImage)(EFI_HANDLE,void *,void *); } bs = {install_table, load_image, start_image};
+static __typeof__(&bs) gBS = &bs;
+static void poison_bs(void) { gBS = NULL; }
+'''
+suffix = r'''
+static void timed_out(int sig) { (void)sig; _exit(starts == 1 && Finished ? 0 : 2); }
+int main(void) {
+  mDataBuffer = mUsbDataBuffer = mFlashDataBuffer = data_buf;
+  assert(FastbootCmdsUnInit() == 0); assert(FastbootCmdsUnInit() == 0);
+  assert(frees == 1 && stops == 1 && fastboot_uninit == 1);
+  assert(!mDataBuffer && !mUsbDataBuffer && !mFlashDataBuffer);
+  UnInitAttempted = UnInitStatus = frees = stops = fastboot_uninit = 0;
+  mDataBuffer = mUsbDataBuffer = mFlashDataBuffer = data_buf; fail_data_free = 1;
+  assert(FastbootCmdsUnInit() != 0); assert(FastbootCmdsUnInit() != 0);
+  assert(frees == 1 && stops == 0 && !mDataBuffer); fail_data_free = 0;
+  Finished = 0; fail_release = 1; assert(GblFastbootEscapeToBootFlow() != 0); assert(Finished && bootflows == 0);
+  Finished = 0; fail_release = 0; assert(GblFastbootEscapeToBootFlow() == 7); assert(Finished && bootflows == 1);
+  Finished = 0; mFlashDataBuffer = data_buf; mFlashNumDataBytes = sizeof(data_buf);
+  fail_load = 1; DoBootEfi("", NULL, 0, TRUE); assert(!Finished && starts == 0);
+  fail_load = 0; fail_release = 1; DoBootEfi("", NULL, 0, FALSE); assert(Finished && starts == 0);
+  fail_release = 0; Finished = 0; starts = 0;
+  for (fail_start = 0; fail_start <= 1; fail_start++) {
+    pid_t child = fork(); assert(child >= 0);
+    if (!child) { signal(SIGALRM, timed_out); alarm(1); DoBootEfi("", NULL, 0, TRUE); _exit(3); }
+    int status; assert(waitpid(child, &status, 0) == child); assert(WIFEXITED(status) && WEXITSTATUS(status) == 0);
+  }
+  puts("PASS: production FastbootCmds uninit, escape and boot-efi return containment");
+  return 0;
+}
+'''
+with tempfile.TemporaryDirectory(prefix='fastboot-cmds-host-') as temp:
+    c = pathlib.Path(temp) / 'test.c'
+    exe = pathlib.Path(temp) / 'test'
+    c.write_text(prefix + '\n\n'.join(function(n) for n in ('FastbootCmdsUnInit', 'DoBootEfi', 'GblFastbootEscapeToBootFlow')) + suffix)
+    subprocess.run([os.environ.get('CC', 'cc'), '-std=gnu11', '-O1', '-g', '-fsanitize=address,undefined', '-fno-omit-frame-pointer', '-no-pie', str(c), '-o', str(exe)], check=True)
+    env = dict(os.environ, ASAN_OPTIONS='detect_leaks=0')
+    subprocess.run([str(exe)], check=True, env=env)
