+#!/bin/sh
+# Host-only white-box regression test for production BlockIoHook.c (Phase B1).
+# Compiles the UNMODIFIED production source against mock UEFI headers plus
+# the REAL HookCommon.h / ProtocolHookLib.h from this worktree.
+set -e
+ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
+cd "$ROOT"
+gcc -std=gnu11 -Wall -Wextra \
+  -I tests/host/hook_rollback/include \
+  -I GblChainloadPkg/Include \
+  -I GblChainloadPkg/Library/ProtocolHookLib \
+  tests/host/hook_rollback/hook_blockio_test.c \
+  -o tests/host/hook_rollback/hook_blockio_test
+tests/host/hook_rollback/hook_blockio_test
