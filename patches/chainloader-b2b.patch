+/* All worker exits return here, including failure and rollback paths. */
+EFI_STATUS
+InstallBlockIoHook (VOID)
+{
+  EFI_STATUS Status;
+  EFI_TPL OldTpl;
+
+  /* The TPL is raised only while examining/updating the guard; no protocol
+     or logging service is called inside this critical section. */
+  OldTpl = gBS->RaiseTPL (TPL_HIGH_LEVEL);
+  if (gBlockIoInstallActive) {
+    gBS->RestoreTPL (OldTpl);
+    return EFI_ALREADY_STARTED;
+  }
+  gBlockIoInstallActive = TRUE;
+  MemoryFence ();
+  gBS->RestoreTPL (OldTpl);
+
+  Status = InstallBlockIoHookWorker ();
+  ZeroMem (gBlockIoCandidates, sizeof (gBlockIoCandidates));
+
+  OldTpl = gBS->RaiseTPL (TPL_HIGH_LEVEL);
+  MemoryFence ();
+  gBlockIoInstallActive = FALSE;
+  gBS->RestoreTPL (OldTpl);
+  return Status;
+}
