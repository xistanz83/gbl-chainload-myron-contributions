+      VerifyResult.Status != PATCH_VERIFY_OK ||
+      VerifyResult.Patch6Verified != PATCH_VERIFY_PATCH6_GATES ||
+      VerifyResult.Patch10Verified != PATCH_VERIFY_PATCH10_SITES) {
+    return EFI_SECURITY_VIOLATION;
