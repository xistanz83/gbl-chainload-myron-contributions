+  if (gSpssSlotState == HOOK_SLOT_OWNED ||
+      gSpssSlotState == HOOK_SLOT_FOREIGN ||
+      Now->SPSSDxe_ShareKeyMintInfo != gOrigShareKeyMintInfo) {
+    gSpssUnresolved = TRUE;
+    return HOOK_UNRESOLVED;
+  }
