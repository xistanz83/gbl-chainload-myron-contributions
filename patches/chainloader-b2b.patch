@@ -0,0 +1,126 @@
+#!/usr/bin/env python3
+"""Characterize the production Fastboot completion wait using scripted events.
+
+These are assertions of existing behavior, including unsafe behavior. They do
+not certify the provider, transfer completion, or firmware execution.
+"""
+import os
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[2]
+source = (root / 'edk2/QcomModulePkg/Library/FastbootLib/FastbootCmds.c').read_text()
+match = re.search(r'\nSTATIC VOID\s+WaitForTransferComplete\s*\(VOID\)\s*\{', source)
+if not match:
+    raise RuntimeError('production WaitForTransferComplete definition not found')
+start = match.start() + 1
+pos = match.end()
+depth = 1
+while depth:
+    if source[pos] == '{':
+        depth += 1
+    elif source[pos] == '}':
+        depth -= 1
+    pos += 1
+wait_body = source[start:pos]
+
+prefix = r'''
+#define _POSIX_C_SOURCE 200809L
+#include <assert.h>
+#include <signal.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <sys/wait.h>
+#include <unistd.h>
+#define STATIC static
+#define VOID void
+#define USB_ENDPOINT_DIRECTION_OUT 0
+#define USB_ENDPOINT_DIRECTION_IN 1
+#define USB_INDEX_TO_EP(index) ((index)&0xf)
+#define USB_INDEX_TO_EPDIR(index) (((index) >> 7 & 0x1) ? USB_ENDPOINT_DIRECTION_IN : USB_ENDPOINT_DIRECTION_OUT)
+typedef size_t UINTN;
+typedef enum { UsbDeviceEventNoEvent, UsbDeviceEventDeviceStateChange, UsbDeviceEventTransferNotification, UsbDeviceEventOemEvent } USB_DEVICE_EVENT;
+typedef enum { UsbDeviceTransferStatusActive, UsbDeviceTransferStatusCompleteOK, UsbDeviceTransferStatusCancelled, UsbDeviceTransferStatusCompleteError } USB_DEVICE_TRANSFER_STATUS;
+typedef enum { UsbDeviceStateConnected, UsbDeviceStateDisconnected } USB_DEVICE_STATE;
+typedef struct { USB_DEVICE_TRANSFER_STATUS Status; uint8_t EndpointIndex; UINTN BytesCompleted; VOID *DataBuffer; } USB_DEVICE_TRANSFER_OUTCOME;
+typedef union { USB_DEVICE_STATE DeviceState; USB_DEVICE_TRANSFER_OUTCOME TransferOutcome; } USB_DEVICE_EVENT_DATA;
+typedef struct { USB_DEVICE_EVENT event; USB_DEVICE_EVENT_DATA data; } MockEvent;
+static unsigned char shared_tx[32];
+static MockEvent queue[3];
+static unsigned queue_len, queue_pos;
+static volatile sig_atomic_t calls;
+static int handle_event(USB_DEVICE_EVENT *event, UINTN *size, USB_DEVICE_EVENT_DATA *data) {
+  if (calls < 10) ++calls;
+  *size = sizeof(*data);
+  if (queue_pos < queue_len) {
+    *event = queue[queue_pos].event;
+    *data = queue[queue_pos++].data;
+  } else {
+    *event = UsbDeviceEventNoEvent;
+  }
+  return 0;
+}
+static struct { int (*HandleEvent)(USB_DEVICE_EVENT *, UINTN *, USB_DEVICE_EVENT_DATA *); } protocol = { handle_event };
+static struct { __typeof__(&protocol) UsbDeviceProtocol; } device = { &protocol };
+static __typeof__(&device) GetFastbootDeviceData(void) { return &device; }
+static void set_completion(unsigned i, USB_DEVICE_TRANSFER_STATUS status, VOID *buf) {
+  queue[i].event = UsbDeviceEventTransferNotification;
+  queue[i].data.TransferOutcome.Status = status;
+  queue[i].data.TransferOutcome.EndpointIndex = 0x81;
+  queue[i].data.TransferOutcome.BytesCompleted = 4;
+  queue[i].data.TransferOutcome.DataBuffer = buf;
+}
+'''
+suffix = r'''
+static void timeout(int sig) { (void)sig; _exit(calls > 1 ? 0 : 2); }
+int main(void) {
+  queue_pos = 0; queue_len = 1; calls = 0;
+  set_completion(0, UsbDeviceTransferStatusCompleteOK, shared_tx);
+  WaitForTransferComplete();
+  assert(queue_pos == 1 && calls == 1);
+  puts("OBSERVED: successful EP1 IN notification returns from production wait");
+
+  /* Both represent the same pointer and endpoint; only the mock knows that
+   * the first is stale. The production structure contains no generation. */
+  queue_pos = 0; queue_len = 2; calls = 0;
+  set_completion(0, UsbDeviceTransferStatusCompleteOK, shared_tx);
+  set_completion(1, UsbDeviceTransferStatusCompleteOK, shared_tx);
+  WaitForTransferComplete();
+  assert(queue_pos == 1 && calls == 1);
+  puts("OBSERVED UNSAFE: stale same-buffer completion returns before current notification");
+
+  queue_pos = 0; queue_len = 1; calls = 0;
+  set_completion(0, UsbDeviceTransferStatusCompleteError, shared_tx);
+  WaitForTransferComplete();
+  assert(queue_pos == 1 && calls == 1);
+  puts("OBSERVED UNSAFE: error-status completion also returns");
+
+  queue_pos = 0; queue_len = 1; calls = 0;
+  queue[0].event = UsbDeviceEventDeviceStateChange;
+  queue[0].data.DeviceState = UsbDeviceStateDisconnected;
+  fflush(stdout);
+  pid_t child = fork(); assert(child >= 0);
+  if (child == 0) {
+    signal(SIGALRM, timeout);
+    alarm(1);
+    WaitForTransferComplete();
+    _exit(3);
+  }
+  int status; assert(waitpid(child, &status, 0) == child);
+  assert(WIFEXITED(status) && WEXITSTATUS(status) == 0);
+  puts("OBSERVED UNSAFE: disconnect then no events remains in wait for bounded observation");
+  return 0;
+}
+'''
+with tempfile.TemporaryDirectory(prefix='fastboot-wait-host-') as directory:
+    src = Path(directory) / 'test.c'
+    binary = Path(directory) / 'test'
+    src.write_text(prefix + wait_body + suffix)
+    subprocess.run([os.environ.get('CC', 'cc'), '-std=gnu11', '-O1', '-g',
+                    '-fsanitize=address,undefined', '-fno-omit-frame-pointer',
+                    '-no-pie', str(src), '-o', str(binary)], check=True)
+    subprocess.run([str(binary)], check=True,
+                   env=dict(os.environ, ASAN_OPTIONS='detect_leaks=0'))
