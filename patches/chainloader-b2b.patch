@@ -0,0 +1,84 @@
+#!/usr/bin/env bash
+# scripts/verify-safeguards.sh — verify mandatory safeguards in a built EFI.
+#
+# Usage: scripts/verify-safeguards.sh <efi-path>
+#
+# Checks:
+#   1. PE/COFF structure (MZ header, PE signature, AArch64 machine type)
+#   2. Recovery escape: both VolUp and VolDown key branches present
+#   3. FastbootLib call path (EnterFastboot / FastbootInitialize)
+#   4. Tier 1 PE gate (GblCachedPeIsSane)
+#   5. Tier 1b verification path (DynamicPatch_VerifyCachedAbl)
+#   6. Mandatory patch failure handling (EFI_SECURITY_VIOLATION on miss)
+#
+# Uses strings + objdump where available. String presence alone is NOT
+# sufficient — this script checks structural markers and control-flow
+# indicators where the tooling allows.
+set -euo pipefail
+
+EFI="${1:?usage: verify-safeguards.sh <efi-path>}"
+
+if [ ! -f "$EFI" ]; then
+  echo "::error::EFI not found: $EFI" >&2
+  exit 1
+fi
+
+PASS=0
+FAIL=0
+
+check() {
+  local desc="$1"
+  shift
+  if "$@" >/dev/null 2>&1; then
+    echo "  PASS: $desc"
+    PASS=$((PASS + 1))
+  else
+    echo "  FAIL: $desc"
+    FAIL=$((FAIL + 1))
+  fi
+}
+
+echo "Verifying safeguards in: $EFI"
+echo "Size: $(stat -c%s "$EFI") bytes"
+echo ""
+
+# 1. PE structure
+check "MZ header" bash -c "head -c2 '$EFI' | grep -q 'MZ'"
+check "PE signature" bash -c "
+  pe_off=$(od -An -tu4 -j0x3c -N4 '$EFI' | tr -d ' ')
+  [ \$(printf '%s' \"\$(dd if='$EFI' bs=1 skip=\$((pe_off)) count=4 2>/dev/null | xxd -p)\")\" = \"50450000\"
+"
+check "AArch64 machine type (0xAA64)" bash -c "
+  pe_off=$(od -An -tu4 -j0x3c -N4 '$EFI' | tr -d ' ')
+  machine=$(od -An -tu2 -j$((pe_off + 4)) -N2 '$EFI' | tr -d ' ')
+  [ "\$machine" = "43604" ]
+"
+
+# 2. Recovery escape — both key branches
+check "VolDown key handling (SCAN_DOWN)" bash -c "strings '$EFI' | grep -qi 'VolDown\|SCAN_DOWN\|GblKeyVolDown'"
+check "VolUp key handling (SCAN_UP)" bash -c "strings '$EFI' | grep -qi 'VolUp\|SCAN_UP\|GblKeyVolUp'"
+
+# 3. FastbootLib call path
+check "FastbootInitialize reference" bash -c "strings '$EFI' | grep -q 'FastbootInitialize'"
+check "EnterFastboot path" bash -c "strings '$EFI' | grep -qi 'FastbootLib\|entering Fastboot'"
+
+# 4. Tier 1 PE gate
+check "GblCachedPeIsSane (Tier 1 gate)" bash -c "strings '$EFI' | grep -q 'GblCachedPeIsSane\|PE sanity gate\|failed PE sanity'"
+
+# 5. Tier 1b verification path
+check "DynamicPatch_VerifierInit" bash -c "strings '$EFI' | grep -q 'DynamicPatch_VerifierInit\|verifier init'"
+check "DynamicPatch_VerifyCachedAbl" bash -c "strings '$EFI' | grep -q 'DynamicPatch_VerifyCachedAbl\|Tier 1b'"
+check "PATCH_VERIFY_PATCH6_GATES=4" bash -c "strings '$EFI' | grep -q 'patch6.*4\|PATCH_VERIFY_PATCH6'"
+
+# 6. Mandatory patch failure handling
+check "EFI_SECURITY_VIOLATION on verify fail" bash -c "strings '$EFI' | grep -qi 'SECURITY_VIOLATION\|verification failed\|FATAL.*Tier 1b'"
+
+echo ""
+echo "Results: $PASS passed, $FAIL failed"
+
+if [ "$FAIL" -gt 0 ]; then
+  echo "::error::safeguard verification FAILED ($FAIL checks)" >&2
+  exit 1
+fi
+
+echo "All safeguard checks passed."
