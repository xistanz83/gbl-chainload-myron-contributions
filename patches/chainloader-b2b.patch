+      case HOOK_SLOT_OWNED:
+        if (BlockIo->WriteBlocks == HookedWriteBlocks) {
+          BlockIo->WriteBlocks = Record->OriginalWriteBlocks;
+          Record->WriteState = HOOK_SLOT_RESTORED;
+        } else if (BlockIo->WriteBlocks == Record->OriginalWriteBlocks) {
+          Record->WriteState = HOOK_SLOT_RESTORED;
+        } else {
+          Record->WriteState = HOOK_SLOT_FOREIGN;
+        }
+        break;
+      case HOOK_SLOT_FOREIGN:
+        if (BlockIo->WriteBlocks == HookedWriteBlocks) {
+          Record->WriteState = HOOK_SLOT_OWNED; /* Restore on a later pass. */
+        } else if (BlockIo->WriteBlocks == Record->OriginalWriteBlocks) {
+          Record->WriteState = HOOK_SLOT_RESTORED;
+        }
+        break;
+      case HOOK_SLOT_RESTORED:
+        if (BlockIo->WriteBlocks != Record->OriginalWriteBlocks) {
+          Record->WriteState = HOOK_SLOT_FOREIGN;
+        }
+        break;
+      default:
+        Record->WriteState = HOOK_SLOT_FOREIGN;
+        break;
+    }
+
+    switch (Record->ReadState) {
+      case HOOK_SLOT_OWNED:
+        if (BlockIo->ReadBlocks == HookedReadBlocks) {
+          BlockIo->ReadBlocks = Record->OriginalReadBlocks;
+          Record->ReadState = HOOK_SLOT_RESTORED;
+        } else if (BlockIo->ReadBlocks == Record->OriginalReadBlocks) {
+          Record->ReadState = HOOK_SLOT_RESTORED;
+        } else {
+          Record->ReadState = HOOK_SLOT_FOREIGN;
+        }
+        break;
+      case HOOK_SLOT_FOREIGN:
+        if (BlockIo->ReadBlocks == HookedReadBlocks) {
+          Record->ReadState = HOOK_SLOT_OWNED;
+        } else if (BlockIo->ReadBlocks == Record->OriginalReadBlocks) {
+          Record->ReadState = HOOK_SLOT_RESTORED;
+        }
+        break;
+      case HOOK_SLOT_RESTORED:
+        if (BlockIo->ReadBlocks != Record->OriginalReadBlocks) {
+          Record->ReadState = HOOK_SLOT_FOREIGN;
+        }
+        break;
+      default:
+        Record->ReadState = HOOK_SLOT_FOREIGN;
+        break;
+    }
+  }
+
+  /* Historical state alone is not proof: recheck identity and current slots. */
+  for (Index = 0; Index < gBlockIoRecordCount; Index++) {
+    Record = &gBlockIoRecords[Index];
+    if (!Record->Active || !BlockIoRecordIsLive (Record)) {
+      Unresolved = TRUE;
+      continue;
+    }
+    BlockIo = Record->BlockIo;
+    if (Record->ReadState != HOOK_SLOT_RESTORED ||
+        Record->WriteState != HOOK_SLOT_RESTORED ||
+        BlockIo->ReadBlocks != Record->OriginalReadBlocks ||
+        BlockIo->WriteBlocks != Record->OriginalWriteBlocks) {
+      Unresolved = TRUE;
+    }
+  }
+  if (Unresolved) {
+    gBlockIoUnresolved = TRUE;
+    return HOOK_UNRESOLVED;
+  }
+
+  /* Keep historical records to revalidate restored slots on later calls. */
+  gBlockIoUnresolved = FALSE;
+  return HOOK_UNINSTALLED;
+}
