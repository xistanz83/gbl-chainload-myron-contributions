+#!/usr/bin/env bash
+# scripts/build-efi.sh — build the firmware EFI from source.
+#
+# Usage: scripts/build-efi.sh <output-path>
+#
+# Builds inside the gbl-chainload-build Docker image (same as
+# scripts/build.sh phase 1+2). Produces a single PE/COFF EFI at
+# <output-path>. Fails closed if any build step fails.
+set -euo pipefail
+
+OUT="${1:?usage: build-efi.sh <output-path>}"
+ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+
+if ! command -v docker &>/dev/null; then
+  echo "::error::docker not found on PATH" >&2
+  exit 1
+fi
+
+# Ensure the build image exists (build it if missing).
+if ! docker image inspect gbl-chainload-build:latest &>/dev/null; then
+  echo "Building gbl-chainload-build:latest ..."
+  docker build -f docker/Dockerfile -t gbl-chainload-build:latest "$ROOT"
+fi
+
+mkdir -p "$(dirname "$OUT")"
+
+docker run --rm \
+  -v "$ROOT:/src" \
+  -w /src \
+  gbl-chainload-build:latest \
+  bash -c '
+    set -euo pipefail
+    # Phase 1: cargo build firmware staticlibs for aarch64-unknown-none.
+    cargo build --release --target aarch64-unknown-none \
+      -p avb-parse -p gblp1 -p mode2-profile-core -p patch-engine -p pe-utils
+
+    # Phase 2: EDK2 build linking staticlibs into the EFI.
+    bash edk2/edk2-basecore/Scripts/Build.sh \
+      -a AARCH64 \
+      -p GblChainloadPkg/GblChainloadPkg.dsc \
+      -b RELEASE \
+      -D GBL_CHAINLOAD_VERSION="$(cat VERSION)" \
+      --workspace edk2
+
+    # Locate the built EFI.
+    efi=$(find edk2/Build -name "gbl-chainload.efi" -path "*/RELEASE/*" | head -1)
+    if [ -z "$efi" ]; then
+      echo "::error::built EFI not found in edk2/Build" >&2
+      exit 1
+    fi
+    cp "$efi" /src/dist/gbl-chainload.efi
+  '
+
+if [ ! -f "$OUT" ] && [ ! -f "$ROOT/dist/gbl-chainload.efi" ]; then
+  echo "::error::build produced no EFI artifact" >&2
+  exit 1
+fi
+
+# Move to requested output path.
+cp "$ROOT/dist/gbl-chainload.efi" "$OUT"
+echo "Built EFI: $OUT ($(stat -c%s "$OUT") bytes)"
