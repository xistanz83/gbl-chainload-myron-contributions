diff --git a/crates/patch-engine/src/abl_permissive/verify.rs b/crates/patch-engine/src/abl_permissive/verify.rs
new file mode 100644
index 0000000000000000000000000000000000000000..af118dd1daaade02e9cce52a087849ae11f9aadc
--- /dev/null
+++ b/crates/patch-engine/src/abl_permissive/verify.rs
@@ -0,0 +1,161 @@
+//! Tier 1b verifier for a host-prepared cached ABL.
+//!
+//! The caller supplies the pristine PE selected from the live ABL partition,
+//! its independently computed SHA-256, and the cached PE. Verification is
+//! non-mutating and fail-closed: the live source must be the trusted myron
+//! Global .302 PE, all four patch6 gates must carry their exact rewritten
+//! instructions, and both patch10 instructions must be present.
+
+use super::{fastboot_lock_gates, libavb_force_success};
+use crate::PatchOutcome;
+
+/// SHA-256 of the PE selected by AblUnwrapLib from myron Global .302.
+pub const TRUSTED_MYRON_GLOBAL_302_PE_SHA256: [u8; 32] = [
+    0xb8, 0x0f, 0xb2, 0x57, 0x4a, 0x29, 0x5a, 0x93,
+    0xba, 0x1c, 0xd5, 0xbf, 0x00, 0xe1, 0xb0, 0x22,
+    0xc4, 0x6f, 0xbd, 0xca, 0x3b, 0x4d, 0xb1, 0xc7,
+    0x6f, 0xce, 0x96, 0xf9, 0x22, 0x87, 0xde, 0xac,
+];
+
+pub const EXPECTED_PATCH6_GATES: u32 = 4;
+pub const EXPECTED_PATCH10_SITES: u32 = 2;
+
+/// Fail-closed Tier 1b outcome. Zero is the only success value.
+#[repr(C)]
+#[derive(Debug, PartialEq, Eq, Clone, Copy)]
+pub enum VerifyStatus {
+    Ok = 0,
+    InvalidInput = 1,
+    NotInitialized = 2,
+    SourceIdentityMismatch = 3,
+    Patch6Miss = 4,
+    Patch6Ambiguous = 5,
+    Patch10Miss = 6,
+    Patch10Ambiguous = 7,
+}
+
+#[repr(C)]
+#[derive(Debug, Clone, Copy)]
+pub struct VerifyResult {
+    pub status: VerifyStatus,
+    pub patch6_verified: u32,
+    pub patch10_verified: u32,
+}
+
+impl VerifyResult {
+    pub const fn failed(status: VerifyStatus) -> Self {
+        Self {
+            status,
+            patch6_verified: 0,
+            patch10_verified: 0,
+        }
+    }
+}
+
+/// Explicit verifier construction. The C ABI wraps this in a versioned
+/// context so a missing initialization step cannot become success.
+pub struct Verifier {
+    _private: (),
+}
+
+impl Verifier {
+    pub const fn new() -> Self {
+        Self { _private: () }
+    }
+
+    pub fn verify(
+        &self,
+        source: &[u8],
+        source_sha256: &[u8; 32],
+        cached: &[u8],
+    ) -> VerifyResult {
+        if source.is_empty() || cached.is_empty() || source.len() != cached.len() {
+            return VerifyResult::failed(VerifyStatus::InvalidInput);
+        }
+        if source_sha256 != &TRUSTED_MYRON_GLOBAL_302_PE_SHA256 {
+            return VerifyResult::failed(VerifyStatus::SourceIdentityMismatch);
+        }
+
+        let (patch6, patch6_verified) = fastboot_lock_gates::verify_all(source, cached);
+        if patch6 != PatchOutcome::Ok || patch6_verified != EXPECTED_PATCH6_GATES {
+            return VerifyResult {
+                status: if patch6 == PatchOutcome::Ambiguous {
+                    VerifyStatus::Patch6Ambiguous
+                } else {
+                    VerifyStatus::Patch6Miss
+                },
+                patch6_verified,
+                patch10_verified: 0,
+            };
+        }
+
+        let (patch10, patch10_verified) =
+            libavb_force_success::verify_applied(source, cached);
+        if patch10 != PatchOutcome::Ok || patch10_verified != EXPECTED_PATCH10_SITES {
+            return VerifyResult {
+                status: if patch10 == PatchOutcome::Ambiguous {
+                    VerifyStatus::Patch10Ambiguous
+                } else {
+                    VerifyStatus::Patch10Miss
+                },
+                patch6_verified,
+                patch10_verified,
+            };
+        }
+
+        VerifyResult {
+            status: VerifyStatus::Ok,
+            patch6_verified,
+            patch10_verified,
+        }
+    }
+}
+
+impl Default for Verifier {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+// --- Tier 2 firmware-identity gate (R3) ---------------------------------
+//
+// Tier 1b binds the *cached* image to a caller-supplied source hash. The
+// pure Tier 2 dynamic path has no such binding: `DynamicPatch_Apply` mutates
+// whatever buffer the C caller hands it, so an unsupported, truncated, or
+// tampered ABL PE that happens to carry all four refusal strings could be
+// patched and handed off. This gate closes that gap by computing SHA-256 over
+// the *complete original, unmodified* unwrapped ABL PE and comparing it with
+// the compiled trusted myron Global .302 selected-PE identity before any patch
+// write may occur.
+//
+// The authenticated bytes are exactly the PE produced by AblUnwrapLib (the
+// same source-selection policy Tier 1b uses). This is deliberately NOT the raw
+// partition / EFI container hash: the trusted constant is the SHA-256 of the
+// embedded PE, and the two are not assumed equal.
+
+/// SHA-256 of a byte slice.
+///
+/// Delegates to [`gblp1::sha256`] — the audited `sha2` crate behind a
+/// `no_std`, alloc-free API (gblp1 builds without std/alloc for the
+/// firmware target). This replaces the earlier handwritten implementation,
+/// which failed standard SHA-256 test vectors.
+pub fn sha256(data: &[u8]) -> [u8; 32] {
+    gblp1::sha256(data)
+}
+
+/// Fail-closed Tier 2 firmware-identity gate.
+///
+/// Computes SHA-256 over the complete original, unmodified ABL PE and accepts
+/// it only if it equals [`TRUSTED_MYRON_GLOBAL_302_PE_SHA256`]. Empty input is
+/// rejected as invalid; any other digest is a source-identity mismatch. This
+/// must run before any dynamic patch write.
+pub fn verify_source_identity(pe: &[u8]) -> VerifyStatus {
+    if pe.is_empty() {
+        return VerifyStatus::InvalidInput;
+    }
+    if sha256(pe) == TRUSTED_MYRON_GLOBAL_302_PE_SHA256 {
+        VerifyStatus::Ok
+    } else {
+        VerifyStatus::SourceIdentityMismatch
+    }
+}
