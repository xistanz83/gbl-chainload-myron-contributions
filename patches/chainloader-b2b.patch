+HOOK_UNINSTALL_RESULT
+UninstallScmHook (VOID)
+{
+  EFI_STATUS Status;
+  QCOM_SCM_PROTOCOL *Scm = NULL;
+  BOOLEAN Unresolved = FALSE;
+
+  if (gSCMUntracked) return HOOK_UNRESOLVED;
+  if (!gSCMRecordActive) return HOOK_NOT_INSTALLED;
+  Status = gBS->HandleProtocol (gSCMHandle, &gQcomScmProtocolGuid, (VOID **)&Scm);
+  if (EFI_ERROR (Status) || Scm == NULL || Scm != gHookedScm) {
+    gSCMUnresolved = TRUE;
+    return HOOK_UNRESOLVED;
+  }
+
+/* Restored slots are rechecked on every call; foreign pointers are never
+ * overwritten. If our wrapper reappears, restoration needs another pass. */
+#define RESOLVE_SCM(Field, Original, Wrapper, I) do {                         \
+    switch (gSCMState[I]) {                                                   \
+    case HOOK_SLOT_OWNED:                                                       \
+      if (Scm->Field == (Wrapper)) { Scm->Field = (Original);                   \
+        gSCMState[I] = HOOK_SLOT_RESTORED; }                                   \
+      else if (Scm->Field == (Original)) gSCMState[I] = HOOK_SLOT_RESTORED;  \
+      else gSCMState[I] = HOOK_SLOT_FOREIGN;                                   \
+      break;                                                                    \
+    case HOOK_SLOT_RESTORED:                                                    \
+      if (Scm->Field != (Original)) gSCMState[I] = HOOK_SLOT_FOREIGN;         \
+      break;                                                                    \
+    case HOOK_SLOT_FOREIGN:                                                      \
+      if ((Original) == NULL && Scm->Field == NULL)                            \
+        gSCMState[I] = HOOK_SLOT_ABSENT;                                        \
+      else if ((Original) != NULL && Scm->Field == (Original))                      \
+        gSCMState[I] = HOOK_SLOT_RESTORED;                                      \
+      else if ((Original) != NULL && Scm->Field == (Wrapper))                  \
+        gSCMState[I] = HOOK_SLOT_OWNED;                                         \
+      break;                                                                    \
+    case HOOK_SLOT_ABSENT: case HOOK_SLOT_STOCK:                                \
+      if (Scm->Field != (Original)) gSCMState[I] = HOOK_SLOT_FOREIGN;          \
+      break;                                                                    \
+    default: gSCMState[I] = HOOK_SLOT_FOREIGN; break;                           \
+    }                                                                           \
+  } while (0)
+  RESOLVE_SCM (ScmQseeSysCall, gOrigScmQseeSysCall, HookedScmQseeSysCall, 4);
+  RESOLVE_SCM (ScmSendCommand, gOrigScmSendCommand, HookedScmSendCommand, 3);
+  RESOLVE_SCM (ScmSipSysCall, gOrigScmSipSysCall, HookedScmSipSysCall, 2);
+  RESOLVE_SCM (ScmFastCall2, gOrigScmFastCall2, HookedScmFastCall2, 1);
+  RESOLVE_SCM (ScmSysCall, gOrigScmSysCall, HookedScmSysCall, 0);
+#undef RESOLVE_SCM
+
+  /* Final scan is deliberately separate from the resolving pass. */
+#define VERIFY_SCM(Field, Original, Wrapper, I) do {                           \
+    if (gSCMState[I] == HOOK_SLOT_RESTORED) {                                 \
+      if (Scm->Field != (Original)) Unresolved = TRUE;                         \
+    } else if (gSCMState[I] == HOOK_SLOT_ABSENT ||                             \
+               gSCMState[I] == HOOK_SLOT_STOCK) {                             \
+      if (Scm->Field != (Original)) Unresolved = TRUE;                          \
+    } else Unresolved = TRUE;                                                   \
+  } while (0)
+  VERIFY_SCM (ScmSysCall, gOrigScmSysCall, HookedScmSysCall, 0);
+  VERIFY_SCM (ScmFastCall2, gOrigScmFastCall2, HookedScmFastCall2, 1);
+  VERIFY_SCM (ScmSipSysCall, gOrigScmSipSysCall, HookedScmSipSysCall, 2);
+  VERIFY_SCM (ScmSendCommand, gOrigScmSendCommand, HookedScmSendCommand, 3);
+  VERIFY_SCM (ScmQseeSysCall, gOrigScmQseeSysCall, HookedScmQseeSysCall, 4);
+#undef VERIFY_SCM
+  gSCMUnresolved = Unresolved;
+  if (Unresolved) return HOOK_UNRESOLVED;
+  gSCMInstalled = FALSE;
+  return HOOK_UNINSTALLED;
+}
