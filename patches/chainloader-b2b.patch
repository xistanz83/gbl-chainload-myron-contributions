@@ -0,0 +1,10 @@
+#!/bin/sh
+set -eu
+ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
+cd "$ROOT"
+EDK=${EDK_ROOT:-$ROOT/edk2}
+TMPDIR_TEST=$(mktemp -d)
+trap 'rm -rf "$TMPDIR_TEST"' EXIT
+CC=${CC:-gcc}
+"$CC" -std=gnu11 -g -O1 -fshort-wchar -fno-builtin -ffunction-sections -fdata-sections -D__FORTIFY_SOURCE -DMDEPKG_NDEBUG -fsanitize=address,undefined -fno-omit-frame-pointer -I "$EDK/MdePkg/Include" -I "$EDK/MdePkg/Include/X64" -I "$EDK/EmbeddedPkg/Include" -I "$EDK/QcomModulePkg/Include" -I "$EDK/QcomModulePkg/Include/Library" -I "$EDK/QcomModulePkg/Library/OpenDice/open-dice/include" -I "$EDK/QcomModulePkg/Library" tests/host/fastboot_usb_lifecycle_test.c -Wl,--gc-sections -o "$TMPDIR_TEST/fastboot_test"
+ASAN_OPTIONS=detect_leaks=0 "$TMPDIR_TEST/fastboot_test"
diff --git a/tests/runall.sh b/tests/runall.sh
index fce570a36196d29aac9b00300aa50652b715efab..15969cd02399f524398b5c5f2d1f520f941810bd 100755
--- a/tests/runall.sh
+++ b/tests/runall.sh
@@ -3,9 +3,66 @@
 set -euo pipefail
 cd "$(dirname "$0")/.."
 
+# ── Disk-space diagnostics (observational only — no behavior change) ────────
+_DISK_MONITOR_PID=""
+
+_disk_report() {
+  local label="$1"
+  echo ""
+  echo "┌── [disk] ${label} ─────────────────────────────────────────" >&2
+  df -h / 2>/dev/null | tail -1 || true
+  # Report separate mounts if present (GH runners may mount /tmp separately)
+  local mp
+  for mp in /tmp /mnt; do
+    if mountpoint -q "$mp" 2>/dev/null; then
+      df -h "$mp" 2>/dev/null | tail -1 || true
+    fi
+  done
+  # Key directory sizes when present
+  local d
+  for d in target .git dist Build edk2/Build; do
+    if [[ -d "$d" ]]; then
+      du -sh "$d" 2>/dev/null || true
+    fi
+  done
+  echo "└───────────────────────────────────────────────────────────────" >&2
+}
+
+# Background periodic disk monitor: emits a one-line summary to stderr every
+# N seconds. Stderr is captured by GitHub Actions, so this appears in the log
+# even if the main process is killed.
+_start_disk_monitor() {
+  local interval="${1:-30}"
+  local label="$2"
+  (
+    while true; do
+      echo "[disk-monitor:${label}] $(df -h / 2>/dev/null | tail -1)" >&2
+      sleep "$interval"
+    done
+  ) &
+  _DISK_MONITOR_PID=$!
+}
+
+_stop_disk_monitor() {
+  if [[ -n "${_DISK_MONITOR_PID:-}" ]]; then
+    kill "$_DISK_MONITOR_PID" 2>/dev/null || true
+    wait "$_DISK_MONITOR_PID" 2>/dev/null || true
+    _DISK_MONITOR_PID=""
+  fi
+}
+
+trap '_stop_disk_monitor' EXIT
+
+# ── End diagnostics helpers ─────────────────────────────────────────────────
+
+_disk_report "START: runall.sh"
+
 echo "== tests/avb =="
+_start_disk_monitor 30 "avb-make"
 make -C tests/avb clean >/dev/null
 make -C tests/avb
+_stop_disk_monitor
+_disk_report "after: tests/avb"
 
 echo "== 045_mode_taxonomy_lint =="
 bash tests/045_mode_taxonomy_lint.sh
@@ -24,15 +81,31 @@ if [[ -f tests/030_signature_lint.sh ]]; then
   bash tests/030_signature_lint.sh
 fi
 
+_disk_report "before: host test loop"
+
 # Host tests (tests/host/0??_*.sh) — fast, run before build smoke.
+_start_disk_monitor 60 "host-tests"
 for t in tests/host/0[0-9][0-9]_*.sh; do
   [ -f "$t" ] || continue
   echo "== $(basename "$t" .sh) =="
   bash "$t"
 done
+_stop_disk_monitor
+
+_disk_report "after: host test loop"
 
 # Build smoke is slowest — last.
-echo "== 010_build_smoke =="
-bash tests/010_build_smoke.sh
+# In the split CI layout, the host-tests job sets SKIP_BUILD_SMOKE=1 so the
+# firmware build runs in its own dedicated job (firmware-smoke) with fresh disk.
+if [[ "${SKIP_BUILD_SMOKE:-}" == "1" ]]; then
+  echo "== 010_build_smoke: SKIPPED (SKIP_BUILD_SMOKE=1; runs in firmware-smoke job) =="
+else
+  echo "== 010_build_smoke =="
+  _start_disk_monitor 20 "build-smoke"
+  bash tests/010_build_smoke.sh
+  _stop_disk_monitor
+fi
+
+_disk_report "END: runall.sh"
 
 echo "ALL TESTS PASS"
