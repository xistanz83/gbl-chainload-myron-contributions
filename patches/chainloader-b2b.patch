new file mode 100644
index 0000000000000000000000000000000000000000..97af713788f7ea496af69b59aac45fd0c78ed8f2
--- /dev/null
+++ b/crates/patch-engine/tests/tier1b.rs
@@ -0,0 +1,194 @@
+//! Host-only regression coverage for the Tier 1b cached-ABL safeguard.
+
+use std::fs;
+use std::path::PathBuf;
+
+use patch_engine::abl_permissive::{
+    fastboot_lock_gates, libavb_force_success,
+    verify::{Verifier, VerifyStatus, EXPECTED_PATCH10_SITES, EXPECTED_PATCH6_GATES},
+};
+use patch_engine::PatchOutcome;
+
+const FLASHING_ANCHOR: &[u8] = b"Flashing is not allowed in Lock State";
+
+fn repo_root() -> PathBuf {
+    let mut path = PathBuf::from(env!("CARGO_MANIFEST_DIR"));
+    path.pop();
+    path.pop();
+    path
+}
+
+/// The myron Global .302 PE is device-specific recovery material that is
+/// git-ignored and never published (see `.gitignore`). On machines where the
+/// local file is present the full Tier 1b suite runs; elsewhere (e.g. CI)
+/// the fixture-dependent tests report an explicit skip instead of failing.
+fn myron_302_pe() -> Option<Vec<u8>> {
+    let path = repo_root().join("tests/images/pe/myron-global-302.efi");
+    match fs::read(&path) {
+        Ok(bytes) => Some(bytes),
+        Err(error) => {
+            eprintln!(
+                "SKIPPED: required local-only fixture unavailable ({}): {error}",
+                path.display()
+            );
+            None
+        }
+    }
+}
+
+/// Guard for fixture-dependent tests. Returns `true` when the test should
+/// proceed; returns `false` (test reports as passed with a SKIPPED
+/// diagnostic on stderr) when the local-only fixture is absent.
+fn require_local_fixture() -> bool {
+    myron_302_pe().is_some()
+}
+
+fn patch6(source: &[u8]) -> Vec<u8> {
+    let mut cached = source.to_vec();
+    let size = cached.len() as u32;
+    assert_eq!(
+        fastboot_lock_gates::apply(&mut cached, size),
+        PatchOutcome::Ok
+    );
+    cached
+}
+
+fn patch10(source: &[u8]) -> Vec<u8> {
+    let mut cached = source.to_vec();
+    let size = cached.len() as u32;
+    assert_eq!(
+        libavb_force_success::apply(&mut cached, size),
+        PatchOutcome::Ok
+    );
+    cached
+}
+
+fn fully_patched(source: &[u8]) -> Vec<u8> {
+    let mut cached = source.to_vec();
+    let size = cached.len() as u32;
+    assert_eq!(
+        libavb_force_success::apply(&mut cached, size),
+        PatchOutcome::Ok
+    );
+    assert_eq!(
+        fastboot_lock_gates::apply(&mut cached, size),
+        PatchOutcome::Ok
